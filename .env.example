APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# Any OpenAI-compatible chat completion endpoint can be used.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local MCP server implemented in this repository.
DEV_MCP_URL=http://localhost:8001/mcp
REPO_ROOT=.
KNOWLEDGE_ROOT=./data/knowledge
KNOWLEDGE_DB_PATH=./data/knowledge.db
MCP_REQUEST_TIMEOUT_SECONDS=20

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Optional DeepEval model configuration.
DEEPEVAL_MODEL=
